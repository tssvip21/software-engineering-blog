{$SITE_ADDRESS} {
    encode zstd gzip
    handle_path /try/* {
        @enabled expression `{$CARE_PUBLIC_DEMO_ENTRY:0} == 1`
        handle @enabled {
            reverse_proxy demo:8000
        }
        handle {
            respond 404
        }
    }
    handle_path /static/* {
        root * /srv/static
        file_server
        header X-Content-Type-Options nosniff
    }
    handle {
        reverse_proxy backend:8000
    }
}
