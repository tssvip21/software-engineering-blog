DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
APP_ORIGIN=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/
# Production: DEBUG=0, HTTPS origin, a persistent data directory, and a strong secret.
# Demo is enabled only by scripts/run_local.py --demo and uses a separate database.
# PostgreSQL deployment: use deploy/docker/production.env.example with compose.production.yaml.
# Local SQLite remains the default when POSTGRES_HOST is not set.
